{
  "enabled": true,
  "name": "Auto Commit on Save",
  "description": "每次保存代码文件后，自动执行 git add 和 git commit",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git diff --cached --quiet || git commit -m \"chore: auto-commit on save\"",
    "timeout": 30
  },
  "workspaceFolderName": "SultansGameReader",
  "shortName": "auto-commit-on-save"
}