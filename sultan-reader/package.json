{
  "name": "sultan-reader",
  "version": "0.8.0",
  "author": "liwenhao0427",
  "description": "苏丹的游戏本地剧情阅读器",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "electron .",
    "pack:win": "npm run build && electron-builder --win dir",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "electron-store": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.3",
    "rcedit": "^4.0.1",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^1.6.1"
  },
  "build": {
    "appId": "com.liwenhao.sultanreader",
    "productName": "SultanReader",
    "icon": "electron/app-icon.png",
    "afterPack": "electron/afterPack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/**/*",
      "appMeta.json",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "electron/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "electron/app-icon.ico",
      "uninstallerIcon": "electron/app-icon.ico",
      "installerHeaderIcon": "electron/app-icon.ico"
    }
  }
}
